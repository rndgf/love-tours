---
import { Image, getImage } from "astro:assets";
import { photosFor } from "../lib/photos.js";

/** Galerie d'une journée, façon carnet de bord : première photo en grand, le reste en grille. */
interface Props {
  slug: string;
  day: number;
  eager?: boolean;
}
const { slug, day, eager = false } = Astro.props;
const VISIBLE = 9; // au-delà : repli sous « + N photos »

const photos = photosFor(slug, day);
// Version 1600 px pour la lightbox (les originaux font 4-5 Mo).
const fulls = await Promise.all(
  photos.map((p) => getImage({ src: p, width: 1600, format: "webp" }))
);
const items = photos.map((image, i) => ({ image, full: fulls[i].src }));
const lead = items[0];
const grid = items.slice(1, VISIBLE);
const rest = items.slice(VISIBLE);
const lb = `${slug}-day-${day}`;
// Nom accessible des vignettes : l'image est décorative (alt=""), le lien
// porte le sens (sinon un lecteur d'écran annonce l'URL du fichier).
const label = (n: number) => `Agrandir la photo ${n} sur ${items.length} du jour ${day}`;

// Gabarits des cadres vides (grille 4 colonnes, 2 en mobile), choisis par
// n° de jour pour varier la page. Le 1er cadre porte « photos à venir ».
const BIG = "col-span-2 row-span-2";
const M = "hidden sm:block"; // cadre masqué en mobile (3 cadres max)
const SKELETONS = [
  [BIG, "", "", M, M], // grand à gauche
  ["", "", M, M], // une rangée de petits
  [`${BIG} sm:col-start-3`, "", "", M, M], // grand à droite
  [BIG, `${BIG} ${M}`], // deux grands
  [`${BIG} sm:col-start-2`, "", "", M, M], // grand au centre
];
const skeleton = SKELETONS[(day - 1) % SKELETONS.length];
---

<!-- Journée sans photo (édition à venir) : cadres vides statiques (rien ne
     charge : pas de pulsation), disposition variée d'un jour à l'autre. -->
{items.length === 0 && (
  <div class="mt-6 grid grid-flow-row-dense grid-cols-2 gap-2 sm:grid-cols-4">
    {skeleton.map((cls, i) => (
      <div aria-hidden={i > 0 ? "true" : undefined} class={`border border-dashed border-navy/30 p-1 ${cls}`}>
        <div class="flex aspect-[4/3] h-full w-full flex-col items-center justify-center gap-2 bg-paper-deep">
          {i === 0 && (
            <>
              <svg viewBox="0 0 24 24" fill="none" class="h-7 w-7 stroke-navy/35" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 8h4l2-2.5h6L17 8h4v11H3z" /><circle cx="12" cy="13" r="3.5" />
              </svg>
              <span class="font-mono text-center text-[10px] uppercase tracking-[0.18em] text-navy/70">photos à venir</span>
            </>
          )}
        </div>
      </div>
    ))}
  </div>
)}

{items.length > 0 && (
  <div class="mt-6">
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
      <a href={lead.full} data-lightbox={lb} aria-label={label(1)} class="group col-span-2 row-span-2 block border border-navy/20 bg-white p-1">
        <Image
          src={lead.image}
          width={1080}
          widths={[640, 1080]}
          sizes="(min-width: 640px) 50vw, 100vw"
          alt=""
          loading={eager ? "eager" : "lazy"}
          fetchpriority={eager ? "high" : "auto"}
          class="aspect-[4/3] h-full w-full object-cover transition duration-300 group-hover:opacity-90"
        />
      </a>
      {grid.map((item, i) => (
        <a href={item.full} data-lightbox={lb} aria-label={label(i + 2)} class="group block border border-navy/20 bg-white p-1">
          <Image
            src={item.image}
            width={640}
            widths={[320, 640]}
            sizes="(min-width: 640px) 25vw, 50vw"
            alt=""
            class="aspect-[4/3] w-full object-cover transition duration-300 group-hover:opacity-90"
          />
        </a>
      ))}
    </div>
    {rest.length > 0 && (
      <details class="group/d mt-2 flex flex-col">
        <summary class="font-mono order-2 cursor-pointer list-none border border-navy/30 bg-paper px-3 py-1.5 text-center text-[11px] uppercase tracking-[0.15em] text-navy transition hover:border-navy">
          <span class="group-open/d:hidden">+ {rest.length} photos</span>
          <span class="hidden group-open/d:inline">replier</span>
        </summary>
        <div class="order-1 mb-2 grid grid-cols-2 gap-2 sm:grid-cols-4">
          {rest.map((item, i) => (
            <a href={item.full} data-lightbox={lb} aria-label={label(i + VISIBLE + 1)} class="group block border border-navy/20 bg-white p-1">
              <Image
                src={item.image}
                width={640}
                widths={[320, 640]}
                sizes="(min-width: 640px) 25vw, 50vw"
                alt=""
                class="aspect-[4/3] w-full object-cover transition duration-300 group-hover:opacity-90"
              />
            </a>
          ))}
        </div>
      </details>
    )}
  </div>
)}
