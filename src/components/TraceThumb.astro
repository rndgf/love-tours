---
/** Planche atlas miniature : trace normalisée 0-1 sur quadrillage, départ/arrivée marqués. */
interface Props {
  thumb: [number, number][];
  label?: string;
  class?: string;
}
const { thumb, label = "", class: className = "" } = Astro.props;
const d = thumb.map(([x, y], i) => `${i === 0 ? "M" : "L"}${x * 100},${y * 100}`).join("");
---

<div class={`atlas-grid relative border border-navy/30 bg-paper-deep/60 ${className}`}>
  <svg viewBox="-8 -8 116 116" class="block w-full text-carmin" aria-hidden="true">
    <path d={d} fill="none" stroke="currentColor" stroke-width="2.5"
      stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
    <circle cx={thumb[0][0] * 100} cy={thumb[0][1] * 100} r="3.5" fill="currentColor" />
    <circle cx={thumb.at(-1)[0] * 100} cy={thumb.at(-1)[1] * 100} r="3.5"
      fill="var(--color-paper)" stroke="currentColor" stroke-width="2" />
  </svg>
  {label && (
    <span class="font-mono absolute bottom-1.5 right-2 text-[9px] uppercase tracking-[0.15em] text-navy/70">{label}</span>
  )}
</div>
