---
import Base from "../layouts/Base.astro";
import Flag from "../components/Flag.astro";
import MiniMap from "../components/MiniMap.astro";
import { Image } from "astro:assets";
import { tours, formatRange, formatHours } from "../lib/tours.js";
import { accentText, accentVar, isBike, moveIcon } from "../lib/mode.js";
import { ICONS } from "../lib/pictos.js";
import { coverFor } from "../lib/photos.js";

// Relevés cumulés ; les km sont distingués par mode (vélo / à pied).
const sum = (list, f) => Math.round(list.reduce((s, t) => s + f(t), 0));
// [valeur, unité collée à la valeur ?, label]
const globalStats = [
  [tours.length, "", "voyages"],
  [sum(tours.filter((t) => isBike(t.mode)), (t) => t.totals.distanceKm), "km", "à vélo"],
  [sum(tours.filter((t) => !isBike(t.mode)), (t) => t.totals.distanceKm), "km", "à pied"],
  [sum(tours, (t) => t.totals.days), "", "jours dehors"],
  [sum(tours, (t) => t.totals.gainM), "m", "de dénivelé +"],
];
const firstYear = Math.min(...tours.map((t) => t.year));
// Pictos du « voyageur » qui parcourt la timeline au scroll (desktop).
const riderBike = moveIcon("vélo");
const riderHike = moveIcon("à pied");
---

<Base title="Love Tours ❤ · nos étés à deux">
  <!-- Héro -->
  <section
    class="relative mx-auto max-w-6xl px-4 pb-10 pt-12 text-center sm:px-6 sm:pb-14 sm:pt-24"
  >
    <p
      class="font-mono text-[10px] font-medium uppercase tracking-[0.3em] text-navy"
    >
      depuis {firstYear}
    </p>
    <h1
      class="font-display mx-auto mt-4 max-w-3xl text-4xl font-semibold leading-tight tracking-tight sm:text-6xl"
      style="text-shadow: 0 0 3px rgba(250,246,238,1), 0 0 10px rgba(250,246,238,1), 0 0 24px rgba(250,246,238,1);"
    >
      Chaque été, une déconnexion,<br /><em>une reconnexion.</em>
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-base text-ink-soft sm:text-lg">
      En amoureux, sur les routes et les chemins. Une année à vélo, l'autre à
      pied. Les <em>Love Tours</em> sont nos itinérances d'été : les traces, les
      kilomètres, les images.
    </p>
  </section>

  <!-- Relevés cumulés, façon cartouche d'atlas -->
  <section class="mx-auto max-w-4xl px-4 sm:px-6">
    <dl
      class="grid grid-cols-2 border-y border-navy sm:grid-cols-5"
      style="background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.6) 14%, rgba(255,255,255,0.6) 86%, rgba(255,255,255,0) 100%);"
    >
      {
        globalStats.map(([value, unit, label], i) => (
          <div
            class={`border-navy/20 px-3 py-4 text-center sm:px-4 sm:py-5
          ${i === 1 || i === 4 ? "border-l" : ""} ${i >= 2 ? "border-t sm:border-t-0" : ""} ${i > 0 ? "sm:border-l" : ""} ${i === 3 ? "hidden sm:block" : ""}`}
          >
            <dd class="font-mono text-2xl font-medium text-navy sm:text-3xl">
              <span class="stat-count">{value}</span>{unit && <span class="text-base sm:text-lg">{unit}</span>}
            </dd>
            <dt class="font-mono mt-1 text-[9px] uppercase tracking-[0.18em] text-navy">
              {label}
            </dt>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Index des années : accès direct à une édition -->
  <nav
    id="year-nav"
    aria-label="Aller à une année"
    class="font-mono sticky top-0 z-20 mt-10 border-b-2 border-navy bg-paper/95 backdrop-blur-sm sm:hidden"
  >
    <!-- Une seule ligne : défilement horizontal (barre masquée), liens
         centrés tant que ça tient (marges auto aux extrémités). -->
    <div class="yn-scroll mx-auto flex max-w-6xl gap-x-1 overflow-x-auto px-4 py-2.5 sm:px-6">
      {
        tours.map((tour) => (
          <a
            href={`#y${tour.year}`}
            data-year={tour.year}
            style={`--accent: ${accentVar(tour.mode)}`}
            class="yn-link shrink-0 px-3 py-1 text-[12px] tracking-[0.12em] text-navy transition first:ml-auto last:mr-auto hover:bg-navy hover:text-paper"
          >
            {tour.year}
          </a>
        ))
      }
    </div>
    <!-- Voyageur mobile : glisse sur la bordure basse de la nav au rythme de
         la progression dans la timeline (même picto/couleur que desktop). -->
    <div
      id="yn-rider"
      aria-hidden="true"
      style="visibility: hidden"
      class="pointer-events-none absolute left-0 top-full flex h-6 w-6 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-navy/30 bg-paper"
    >
      <svg viewBox={riderBike.viewBox} class="rider-bike h-3.5 w-3.5" aria-hidden="true">
        <path d={riderBike.d} fill="var(--color-carmin)" />
      </svg>
      <svg viewBox={riderHike.viewBox} class="rider-hike hidden h-3.5 w-3.5" aria-hidden="true">
        <path d={riderHike.d} fill="var(--color-sapin)" />
      </svg>
    </div>
  </nav>

  <!-- Planches des éditions, sur le fil des années -->
  <!-- pb desktop : marge de scroll sous la dernière carte (2021) pour que le
       voyageur de la timeline puisse descendre jusqu'en bas du fil. -->
  <section class="mx-auto mt-10 max-w-6xl px-4 sm:mt-12 sm:px-6 min-[1400px]:pb-12">
    <ol id="timeline" class="relative space-y-8">
      <div
        aria-hidden="true"
        class="absolute bottom-6 left-[-3.25rem] top-6 hidden w-9 -translate-x-1/2 min-[1400px]:block"
        style="background-image: url(data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%2736%27%20height=%27120%27%20viewBox=%270%200%2036%20120%27%3E%3Cpath%20d=%27M18,0%20C2,30%2034,90%2018,120%27%20fill=%27none%27%20stroke=%27%231e2f4d%27%20stroke-opacity=%270.6%27%20stroke-width=%271.6%27%20stroke-dasharray=%270.5%206.5%27%20stroke-linecap=%27round%27/%3E%3C/svg%3E); background-repeat: repeat-y; background-position: top center;"
      />
      <!-- Pointe de flèche en tête du chemin : le voyage continue vers les prochains étés. -->
      <svg
        aria-hidden="true"
        viewBox="0 0 16 16"
        fill="none"
        class="absolute left-[-3.25rem] top-2 hidden h-5 w-5 -translate-x-1/2 min-[1400px]:block"
      >
        <!-- Pointe de flèche cartographique (queue d'aronde), pleine -->
        <path d="M8 2 L13 12 L8 9.2 L3 12 Z" fill="#1e2f4d" />
      </svg>
      <!-- Voyageur : cycliste ou randonneur (selon la carte en regard) qui
           descend le fil au rythme du scroll (script en bas de page). -->
      <div
        id="tl-rider"
        aria-hidden="true"
        class="pointer-events-none absolute left-[-3.25rem] top-6 z-10 hidden h-7 w-7 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-navy/30 bg-paper min-[1400px]:flex"
      >
        <svg viewBox={riderBike.viewBox} class="rider-bike h-4 w-4" aria-hidden="true">
          <path d={riderBike.d} fill="var(--color-carmin)" />
        </svg>
        <svg viewBox={riderHike.viewBox} class="rider-hike hidden h-4 w-4" aria-hidden="true">
          <path d={riderHike.d} fill="var(--color-sapin)" />
        </svg>
      </div>
      {
        tours.map((tour, ti) => {
          const cover = coverFor(tour);
          const accent = accentText(tour.mode);
          return (
            <li
              id={`y${tour.year}`}
              class="timeline-item relative scroll-mt-14"
              style={`--accent: ${accentVar(tour.mode)}`}
              data-mode={tour.mode}
            >
              <span
                aria-hidden="true"
                class="tl-year font-display absolute left-[-8.25rem] top-1/2 hidden w-16 -translate-y-1/2 text-right text-2xl font-semibold text-navy min-[1400px]:block"
              >
                {tour.year}
              </span>
              <span
                aria-hidden="true"
                class="tl-dot absolute left-[-3.25rem] top-1/2 hidden h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-paper bg-navy min-[1400px]:block"
              />
              <a
                href={`/tours/${tour.slug}/`}
                class={`group relative grid gap-5 overflow-hidden border border-navy/40 bg-white/75 p-4 transition hover:border-navy hover:shadow-lg hover:shadow-navy/5 sm:gap-6 sm:p-7 ${cover ? "sm:grid-cols-[210px_1fr_210px]" : "sm:grid-cols-[230px_1fr]"}`}
              >
                <span
                  aria-hidden="true"
                  class="font-display pointer-events-none absolute inset-0 hidden select-none items-center justify-center text-[11rem] font-semibold leading-none tracking-tight text-navy/[0.045] sm:flex"
                >
                  {tour.year}
                </span>
                {cover && (
                  <div class="relative -mx-4 -mt-4 sm:hidden">
                    <Image
                      src={cover}
                      width={640}
                      widths={[320, 640]}
                      sizes="100vw"
                      alt=""
                      loading={ti === 0 ? "eager" : "lazy"}
                      fetchpriority={ti === 0 ? "high" : "auto"}
                      class="aspect-[16/10] w-full object-cover"
                    />
                  </div>
                )}
                <MiniMap
                  slug={tour.slug}
                  mode={tour.mode}
                  class="relative mx-auto hidden w-44 self-center sm:block sm:w-full"
                />
                <div class="relative flex flex-col justify-center">
                  <span
                    aria-hidden="true"
                    class="font-display pointer-events-none absolute inset-0 flex select-none items-center justify-center text-[6.5rem] font-semibold leading-none tracking-tight text-navy/[0.045] sm:hidden"
                  >
                    {tour.year}
                  </span>
                  <p class="font-mono text-[10px] font-medium uppercase tracking-[0.2em] text-navy">
                    {tour.mode}
                    {tour.country && ` · ${tour.country}`}
                  </p>
                  <h2 class="font-display mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">
                    <Flag flag={tour.flag} /> {tour.title}
                  </h2>
                  <p class="mt-1 text-sm italic text-ink-soft">
                    {formatRange(tour.startDate, tour.endDate)}
                  </p>
                  {tour.description && (
                    <p class="mt-4 max-w-2xl text-ink-soft">
                      {tour.description}
                    </p>
                  )}
                  <div class="font-mono mt-5 grid max-w-sm grid-cols-3">
                    {[
                      [`${Math.round(tour.totals.distanceKm)}km`, "distance", ICONS.route.d, "fa", ICONS.route.viewBox],
                      [`${tour.totals.gainM}mD+`, "dénivelé", ICONS.mountain.d, "fa", ICONS.mountain.viewBox],
                      [formatHours(tour.totals.movingS), "effort", moveIcon(tour.mode).d, "fa", moveIcon(tour.mode).viewBox],
                    ].map(([value, label, icon, extra, vb], i) => (
                      <div class={`text-center ${i > 0 ? "border-l border-navy/20" : ""}`}>
                        <svg
                          width="14"
                          height="14"
                          viewBox={vb ?? "0 0 16 16"} preserveAspectRatio="xMidYMax meet"
                          fill="none"
                          class="stroke-navy mx-auto mb-1"
                          stroke-width="1.3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          {extra === "dot" && <circle cx="2.5" cy="13" r="1.2" class="fill-navy" stroke="none" />}
                          <path d={icon} {...(extra === "fa" ? { class: "fill-navy", stroke: "none" } : {})} />
                        </svg>
                        <div class={`text-[12px] font-medium ${accent}`}>{value}</div>
                        <div class="mt-0.5 text-[8px] uppercase tracking-[0.14em] text-navy">{label}</div>
                      </div>
                    ))}
                  </div>
                </div>
                {cover && (
                  <div class="relative hidden self-center overflow-hidden sm:block">
                    <Image
                      src={cover}
                      width={560}
                      widths={[280, 560]}
                      sizes="210px"
                      alt=""
                      loading={ti === 0 ? "eager" : "lazy"}
                      fetchpriority={ti === 0 ? "high" : "auto"}
                      class="aspect-square w-full object-cover"
                    />
                  </div>
                )}
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>
</Base>

<script>
  // Voyageurs de la timeline — desktop : le long du fil vertical ; mobile :
  // sur la bordure basse de la nav des années (avec lien de l'année active).
  // Les deux suivent le centre du viewport avec une petite traîne (rattrapage
  // à 12 % de l'écart par image, arrêt net sous 0,5 px), picto et couleur du
  // mode de la carte en regard, masqués hors des cartes.
  const ol = document.getElementById("timeline");
  if (ol) {
    const items = [...ol.querySelectorAll<HTMLElement>(".timeline-item")];
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    const clamp = (v: number, lo: number, hi: number) => Math.min(Math.max(v, lo), hi);
    const mkLerp = (apply: (v: number) => void) => {
      let target = 0;
      let cur = 0;
      let raf = 0;
      const step = () => {
        cur += (target - cur) * 0.12;
        if (Math.abs(target - cur) < 0.5) {
          cur = target;
          raf = 0;
        } else {
          raf = requestAnimationFrame(step);
        }
        apply(cur);
      };
      return {
        to(v: number) {
          target = v;
          if (reduced.matches) {
            cur = v;
            apply(v);
          } else if (!raf) {
            raf = requestAnimationFrame(step);
          }
        },
        settle() {
          cur = target;
          apply(cur);
        },
      };
    };
    const setIcon = (root: HTMLElement, mode?: string) => {
      root.querySelector(".rider-bike")?.classList.toggle("hidden", mode !== "vélo");
      root.querySelector(".rider-hike")?.classList.toggle("hidden", mode === "vélo");
    };

    const rider = document.getElementById("tl-rider");
    const tlLerp = rider ? mkLerp((v) => (rider.style.top = `${v}px`)) : null;
    const PAD = 24; // le fil s'arrête à 1.5rem des bords du <ol> (top-6/bottom-6)

    const nav = document.getElementById("year-nav");
    const ynRider = document.getElementById("yn-rider");
    const links = nav ? [...nav.querySelectorAll<HTMLElement>(".yn-link")] : [];
    const ynLerp = ynRider ? mkLerp((v) => (ynRider.style.left = `${v}px`)) : null;
    const X_PAD = 20; // le voyageur mobile ne colle pas aux bords de la nav
    let lastActive: HTMLElement | null = null;

    const update = () => {
      const rect = ol.getBoundingClientRect();
      const center = window.innerHeight / 2;
      // Carte dont la zone verticale contient le centre du viewport. Aucune
      // (avant la timeline, ou tout en bas) : voyageurs masqués — pas de
      // picto par défaut qui recouvrirait la flèche du fil.
      const cur = items.find((li) => {
        const r = li.getBoundingClientRect();
        return center >= r.top - 16 && center < r.bottom + 16;
      });
      if (rider && tlLerp) {
        rider.style.visibility = cur ? "visible" : "hidden";
        if (cur) {
          tlLerp.to(clamp(center - rect.top, PAD, rect.height - PAD));
          setIcon(rider, cur.dataset.mode);
        }
      }
      if (nav && ynRider && ynLerp && nav.offsetWidth) {
        links.forEach((l) =>
          l.classList.toggle("is-active", !!cur && l.dataset.year === cur.id.slice(1))
        );
        // Rangée défilante : recentre l'année active quand elle change.
        const active = cur ? links.find((l) => l.dataset.year === cur.id.slice(1)) : null;
        if (active && active !== lastActive) {
          lastActive = active;
          const sc = active.parentElement!;
          sc.scrollTo({
            left: active.offsetLeft - (sc.clientWidth - active.offsetWidth) / 2,
            behavior: "smooth",
          });
        }
        ynRider.style.visibility = cur ? "visible" : "hidden";
        if (cur) {
          const p = clamp((center - rect.top) / rect.height, 0, 1);
          ynLerp.to(X_PAD + p * (nav.offsetWidth - 2 * X_PAD));
          setIcon(ynRider, cur.dataset.mode);
        }
      }
    };
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    // Position de départ sans traîne (chargement en milieu de page, #y…).
    update();
    tlLerp?.settle();
    ynLerp?.settle();
  }
</script>
