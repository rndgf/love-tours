---
import Base from "../layouts/Base.astro";
import MiniMap from "../components/MiniMap.astro";
import { Image } from "astro:assets";
import { tours, formatRange } from "../lib/tours.js";
import { coverFor } from "../lib/photos.js";

const totalKm = Math.round(tours.reduce((s, t) => s + t.totals.distanceKm, 0));
const totalDays = tours.reduce((s, t) => s + t.totals.days, 0);
const totalGain = tours.reduce((s, t) => s + t.totals.gainM, 0);
const firstYear = Math.min(...tours.map((t) => t.year));
---

<Base title="Love Tours ❤ — nos étés à deux">
  <!-- Héro -->
  <section
    class="mx-auto max-w-6xl px-4 pb-10 pt-12 text-center sm:px-6 sm:pb-14 sm:pt-24"
  >
    <p
      class="font-mono text-[11px] font-medium uppercase tracking-[0.3em] text-carmin"
    >
      depuis {firstYear}
    </p>
    <h1
      class="font-display mx-auto mt-4 max-w-3xl text-4xl font-semibold leading-tight tracking-tight sm:text-6xl"
    >
      Chaque été, une déconnexion,<br /><em>une reconnexion.</em>
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-base text-ink-soft sm:text-lg">
      En amoureux, sur les routes et les chemins. Une année à vélo, l'autre à
      pied — les <em>Love Tours</em> sont nos itinérances d'été : les traces, les
      kilomètres, les images.
    </p>
  </section>

  <!-- Relevés cumulés, façon cartouche d'atlas -->
  <section class="mx-auto max-w-4xl px-4 sm:px-6">
    <dl class="grid grid-cols-2 border-y-2 border-navy sm:grid-cols-4">
      {
        [
          [tours.length, "expéditions"],
          [`${totalKm}`, "km parcourus"],
          [totalDays, "jours dehors"],
          [`${totalGain}`, "m de dénivelé +"],
        ].map(([value, label], i) => (
          <div
            class={`border-navy/20 px-3 py-4 text-center sm:px-4 sm:py-5
          ${i % 2 === 1 ? "border-l" : ""} ${i >= 2 ? "border-t sm:border-t-0" : ""} ${i > 0 ? "sm:border-l" : ""}`}
          >
            <dd class="font-mono text-2xl font-medium text-carmin sm:text-3xl">
              {value}
            </dd>
            <dt class="font-mono mt-1 text-[10px] uppercase tracking-[0.18em] text-navy">
              {label}
            </dt>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Index des années : accès direct à une édition -->
  <nav
    aria-label="Aller à une année"
    class="font-mono sticky top-0 z-20 mt-10 border-b-2 border-navy bg-paper/95 backdrop-blur-sm sm:hidden"
  >
    <div class="mx-auto flex max-w-6xl flex-wrap justify-center gap-x-1 gap-y-1 px-4 py-2.5 sm:px-6">
      {
        tours.map((tour) => (
          <a
            href={`#y${tour.year}`}
            class="px-3 py-1 text-[12px] tracking-[0.12em] text-navy transition hover:bg-navy hover:text-paper"
          >
            {tour.year}
          </a>
        ))
      }
    </div>
  </nav>

  <!-- Planches des éditions, sur le fil des années -->
  <section class="mx-auto mt-10 max-w-6xl px-4 sm:mt-12 sm:px-6">
    <ol class="relative space-y-8">
      <div
        aria-hidden="true"
        class="absolute bottom-6 left-[-3.25rem] top-6 hidden w-9 -translate-x-1/2 min-[1400px]:block"
        style="background-image: url(data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20width=%2736%27%20height=%27120%27%20viewBox=%270%200%2036%20120%27%3E%3Cpath%20d=%27M18,0%20C2,30%2034,90%2018,120%27%20fill=%27none%27%20stroke=%27%231e2f4d%27%20stroke-opacity=%270.6%27%20stroke-width=%271.6%27%20stroke-dasharray=%270.5%206.5%27%20stroke-linecap=%27round%27/%3E%3C/svg%3E); background-repeat: repeat-y; background-position: top center;"
      />
      {
        tours.map((tour, ti) => {
          const cover = coverFor(tour);
          const accentText = tour.mode === "vélo" ? "text-carmin" : "text-sapin";
          return (
            <li id={`y${tour.year}`} class="relative scroll-mt-14">
              <span
                aria-hidden="true"
                class="font-display absolute left-[-8.25rem] top-1/2 hidden w-16 -translate-y-1/2 text-right text-2xl font-semibold text-navy min-[1400px]:block"
              >
                {tour.year}
              </span>
              <span
                aria-hidden="true"
                class="absolute left-[-3.25rem] top-1/2 hidden h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-paper bg-navy min-[1400px]:block"
              />
              <a
                href={`/tours/${tour.slug}/`}
                class={`group relative grid gap-5 overflow-hidden border border-navy/25 bg-white/60 p-4 transition hover:border-navy hover:shadow-lg hover:shadow-navy/5 sm:gap-6 sm:p-7 ${cover ? "sm:grid-cols-[210px_1fr_210px]" : "sm:grid-cols-[230px_1fr]"}`}
              >
                <span
                  aria-hidden="true"
                  class="font-display pointer-events-none absolute inset-0 hidden select-none items-center justify-center text-[11rem] font-semibold leading-none tracking-tight text-navy/[0.045] sm:flex"
                >
                  {tour.year}
                </span>
                {cover && (
                  <div class="relative -mx-4 -mt-4 sm:hidden">
                    <Image
                      src={cover}
                      width={640}
                      widths={[320, 640]}
                      sizes="100vw"
                      alt=""
                      loading={ti === 0 ? "eager" : "lazy"}
                      fetchpriority={ti === 0 ? "high" : "auto"}
                      class="aspect-[16/10] w-full object-cover"
                    />
                  </div>
                )}
                <MiniMap
                  slug={tour.slug}
                  mode={tour.mode}
                  class="relative mx-auto hidden w-44 self-center sm:block sm:w-full"
                />
                <div class="relative flex flex-col justify-center">
                  <span
                    aria-hidden="true"
                    class="font-display pointer-events-none absolute inset-0 flex select-none items-center justify-center text-[6.5rem] font-semibold leading-none tracking-tight text-navy/[0.045] sm:hidden"
                  >
                    {tour.year}
                  </span>
                  <p class="font-mono text-[11px] font-medium uppercase tracking-[0.2em] text-navy">
                    {tour.mode}
                    {tour.country && ` · ${tour.country}`}
                  </p>
                  <h2 class="font-display mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">
                    {tour.flag} {tour.title}
                  </h2>
                  <p class="mt-1 text-sm italic text-ink-soft">
                    {formatRange(tour.startDate, tour.endDate)}
                  </p>
                  {tour.description && (
                    <p class="mt-4 max-w-2xl text-ink-soft">
                      {tour.description}
                    </p>
                  )}
                  <p class="font-mono mt-5 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[13px] text-navy">
                    <span class="flex items-center gap-1.5">
                      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="stroke-navy" stroke-width="1.3" stroke-linecap="round" aria-hidden="true">
                        <path d="M2 12 C5 8 7 13 10 9 S14 5 14 4" />
                        <circle cx="2" cy="12" r="1.2" class="fill-navy" stroke="none" />
                        <path d="M11.5 4 H14 V6.5" />
                      </svg>
                      <span><strong class={`font-medium ${accentText}`}>{Math.round(tour.totals.distanceKm)}</strong>km</span>
                    </span>
                    <span class="flex items-center gap-1.5">
                      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="stroke-navy" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M1.5 13 L6 5.5 L8.5 9.5 L11 6 L14.5 13 Z" />
                      </svg>
                      <span><strong class={`font-medium ${accentText}`}>{tour.totals.gainM}m</strong>D+</span>
                    </span>
                    <span class="flex items-center gap-1.5">
                      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="stroke-navy" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M2.5 3.5 h11 v10 h-11 Z M2.5 6.5 h11 M5 1.8 V4.2 M11 1.8 V4.2" />
                      </svg>
                      <span><strong class={`font-medium ${accentText}`}>{tour.totals.days}</strong>&nbsp;jours</span>
                    </span>
                    {tour.totals.photos > 0 && (
                      <span class="flex items-center gap-1.5">
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="stroke-navy" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M1.5 5 h3 l1.2 -1.8 h4.6 L11.5 5 h3 v8 h-13 Z" />
                          <circle cx="8" cy="8.8" r="2.4" />
                        </svg>
                        <span><strong class={`font-medium ${accentText}`}>{tour.totals.photos}</strong>&nbsp;photos</span>
                      </span>
                    )}
                  </p>
                </div>
                {cover && (
                  <div class="relative hidden self-center overflow-hidden sm:block">
                    <Image
                      src={cover}
                      width={640}
                      widths={[320, 640]}
                      sizes="210px"
                      alt=""
                      class="aspect-square w-full object-cover"
                    />
                  </div>
                )}
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>
</Base>
