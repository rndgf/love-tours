---
import Base from "../../layouts/Base.astro";
import TourMap from "../../components/TourMap.astro";
import DayGallery from "../../components/DayGallery.astro";
import Lightbox from "../../components/Lightbox.astro";
import {
  tours,
  formatRange,
  formatDay,
  formatHours,
  stageName,
} from "../../lib/tours.js";
import { dayColor } from "../../lib/palette.js";
import { accentText, accentHover, moveIcon } from "../../lib/mode.js";
import { ICONS } from "../../lib/pictos.js";

export function getStaticPaths() {
  return tours.map((tour, i) => ({
    params: { slug: tour.slug },
    props: { tour, older: tours[i + 1] ?? null, newer: tours[i - 1] ?? null },
  }));
}
const { tour, older, newer } = Astro.props;
const accent = accentText(tour.mode);
// Picto « en mouvement » : vélo ou marcheur selon le mode de l'édition.
const move = moveIcon(tour.mode);
// Survol des liens de navigation : accent de l'édition CIBLE (carmin vélo, sapin à pied)
const hoverAccent = (t) => accentHover(t.mode);

const fmtCoord = (v, pos, neg) => {
  const abs = Math.abs(v);
  let deg = Math.floor(abs);
  // L'arrondi des minutes peut donner 60 (ex. 47.9995°) : reporter sur le degré.
  let min = Math.round((abs - deg) * 60);
  if (min === 60) { deg += 1; min = 0; }
  return `${deg}°${String(min).padStart(2, "0")}′${v >= 0 ? pos : neg}`;
};
const cornerNW = `${fmtCoord(tour.bbox[3], "N", "S")} · ${fmtCoord(tour.bbox[0], "E", "O")}`;

// Modes de transfert (bus…) présents : pilote la légende des pointillés.
// Calculés à l'import (tours:import) et stockés dans le JSON du tour.
const transferModes = tour.transferModes ?? [];
---

<Base
  title={`${tour.title} ${tour.year} — Love Tours ❤`}
  description={tour.description}
>
  <!-- En-tête -->
  <section class="mx-auto max-w-6xl px-4 pb-8 pt-8 sm:px-6 sm:pb-10 sm:pt-14">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
      <a
        href="/"
        class="font-mono text-[10px] uppercase tracking-[0.15em] text-ink-soft transition hover:text-carmin"
        >← tous les Love Tours</a
      >
      <div class="font-mono flex gap-4 text-[10px] uppercase tracking-[0.15em]">
        {
          older ? (
            <a
              href={`/tours/${older.slug}/`}
              class={`text-ink-soft transition ${hoverAccent(older)}`}
              title={older.title}
            >
              ← {older.year}
            </a>
          ) : (
            <span class="cursor-default select-none text-navy/25" aria-hidden="true">←</span>
          )
        }
        {
          newer ? (
            <a
              href={`/tours/${newer.slug}/`}
              class={`text-ink-soft transition ${hoverAccent(newer)}`}
              title={newer.title}
            >
              {newer.year} →
            </a>
          ) : (
            <span class="cursor-default select-none text-navy/25" aria-hidden="true">→</span>
          )
        }
      </div>
    </div>
    <div class="relative">
      <span
        aria-hidden="true"
        class="font-display pointer-events-none absolute inset-0 flex select-none items-center justify-center text-[7rem] font-semibold leading-none tracking-tight text-navy/[0.045] sm:text-[15rem]"
        >{tour.year}</span
      >
      <p
        class="font-mono mt-7 text-[10px] font-medium uppercase tracking-[0.2em] text-navy"
      >
        {tour.mode}{tour.country && ` · ${tour.country}`}
      </p>
      <h1
        class="font-display mt-1 text-3xl font-semibold tracking-tight sm:text-5xl"
      >
        {tour.flag}&nbsp;
        {tour.title}
      </h1>
    </div>
    <p class="mt-2 text-ink-soft italic">
      {formatRange(tour.startDate, tour.endDate)}
    </p>
    {
      tour.description && (
        <p class="mt-4 max-w-2xl text-base text-ink-soft sm:mt-5 sm:text-lg">
          {tour.description}
        </p>
      )
    }

    <dl
      id="edition-stats"
      class="mt-9 grid scroll-mt-4 grid-cols-2 border-y-2 border-navy sm:grid-cols-4 sm:scroll-mt-28"
      style="background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.6) 14%, rgba(255,255,255,0.6) 86%, rgba(255,255,255,0) 100%);"
    >
      {
        [
          [tour.totals.distanceKm, "km"],
          [tour.totals.days, "jours"],
          [tour.totals.gainM, "m dénivelé +"],
          [formatHours(tour.totals.movingS), "effort"],
        ].map(([value, label], i) => (
          <div
            class={`border-navy/20 px-2 py-3 text-center sm:px-4 sm:py-4
          ${i % 2 === 1 ? "border-l" : ""} ${i >= 2 ? "border-t sm:border-t-0" : ""} ${i > 0 ? "sm:border-l" : ""}`}
          >
            <dd class={`font-mono text-xl font-medium ${accent} sm:text-2xl`}>
              {value}
            </dd>
            <dt class="font-mono mt-0.5 text-[9px] uppercase tracking-[0.18em] text-navy">
              {label}
            </dt>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Planche cartographique -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6">
    <figure class="border-2 border-navy bg-white/80">
      <figcaption class="border-b-2 border-navy px-4 py-2">
        <span class="font-display text-lg font-semibold tracking-wide text-navy">
          {cornerNW}
        </span>
      </figcaption>
      <TourMap slug={tour.slug} bbox={tour.bbox} days={tour.days} />
      <div
        class="flex flex-wrap items-center justify-between gap-2 border-t-2 border-navy px-4 py-2.5"
      >
        <div class="flex flex-wrap gap-1.5">
          <button
            data-zoom-day="0"
            data-zoom-slug={tour.slug}
            class="font-mono min-h-[30px] border border-navy/30 bg-paper px-2 py-0.5 text-[9px] uppercase tracking-[0.1em] text-navy transition hover:border-navy sm:min-h-0 sm:px-2.5 sm:py-1 sm:text-[10px]"
            >Tout</button
          >
          {
            tour.days.filter((day) => !day.noTrace).map((day) => (
              <button
                data-zoom-day={day.n}
                data-zoom-slug={tour.slug}
                class="font-mono flex min-h-[30px] items-center gap-1 border border-navy/30 bg-paper px-2 py-0.5 text-[9px] uppercase tracking-[0.1em] text-navy transition hover:border-navy sm:gap-1.5 sm:min-h-0 sm:px-2.5 sm:py-1 sm:text-[10px]"
              >
                <span
                  class="inline-block h-2 w-2"
                  style={`background:${dayColor(day.n)}`}
                />
                {day.label}
              </button>
            ))
          }
        </div>
        {
          transferModes.length > 0 && (
            <span class="font-mono flex items-center gap-2 text-[9px] uppercase tracking-[0.12em] text-navy/70">
              <svg width="26" height="4" viewBox="0 0 26 4" aria-hidden="true">
                <path d="M2 2 H24" class="stroke-navy/60" stroke-width="2" stroke-linecap="round" stroke-dasharray="0.5 5" />
              </svg>
              liaison en {transferModes.join(", ")}
            </span>
          )
        }
      </div>
    </figure>
  </section>

  <!-- Journal des journées -->
  <section
    class="mx-auto mt-12 max-w-6xl space-y-7 px-4 sm:mt-16 sm:space-y-9 sm:px-6"
  >
    {
      tour.days.map((day) => (
        <article class="border border-navy/40 bg-white/75 p-4 sm:p-7">
          <header class="sm:flex sm:items-center sm:justify-between sm:gap-6">
            <div class="min-w-0">
              <div class="flex items-stretch gap-3">
                <span
                  class="font-mono flex w-9 shrink-0 items-center justify-center text-xs font-medium text-white"
                  style={`background:${dayColor(day.n)}`}
                >
                  {day.label}
                </span>
                <div class="min-w-0">
                  <p class="font-mono flex items-center gap-2.5 text-[9px] font-medium uppercase tracking-[0.18em] text-navy">
                    {formatDay(day.date)}
                    {day.estimated && (
                      <span
                        class="border border-navy/30 bg-paper-deep px-1.5 py-0.5 tracking-[0.1em]"
                        title="Activité non enregistrée : tracé planifié, temps extrapolés de l'allure des autres jours"
                      >
                        estimé
                      </span>
                    )}
                  </p>
                  <h2 class="font-display mt-1 text-xl font-semibold tracking-tight sm:text-2xl">
                {day.title
                  ? day.title
                  : day.from && day.to
                    ? day.loop
                      ? `Boucle depuis ${day.from}`
                      : `De ${day.from} à ${day.to}`
                    : stageName(day.name, tour.title) || formatDay(day.date)}
                  </h2>
                </div>
              </div>
              {!day.noTrace && (
                <p class="font-mono mt-2 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[11px] text-navy sm:hidden">
                  <span class="flex items-center gap-1.5">
                    <svg width="14" height="14" viewBox={ICONS.route.viewBox} preserveAspectRatio="xMidYMax meet" fill="none" aria-hidden="true">
                      <path d={ICONS.route.d} class="fill-navy" />
                    </svg>
                    <span><strong class="font-medium" style={`color:${dayColor(day.n)}`}>{day.distanceKm}</strong>km</span>
                  </span>
                  <span class="flex items-center gap-1.5">
                    <svg width="14" height="14" viewBox={ICONS.mountain.viewBox} preserveAspectRatio="xMidYMax meet" fill="none" aria-hidden="true">
                      <path d={ICONS.mountain.d} class="fill-navy" />
                    </svg>
                    <span><strong class="font-medium" style={`color:${dayColor(day.n)}`}>{day.gainM}m</strong>D+</span>
                  </span>
                  <span class="flex items-center gap-1.5">
                    <svg width="14" height="14" viewBox={move.viewBox} preserveAspectRatio="xMidYMax meet" fill="none" aria-hidden="true">
                      <path d={move.d} class="fill-navy" />
                    </svg>
                    <span><strong class="font-medium" style={`color:${dayColor(day.n)}`}>{formatHours(day.movingS)}</strong></span>
                  </span>
                  <span class="flex items-center gap-1.5">
                    <svg width="14" height="14" viewBox={ICONS.clock.viewBox} preserveAspectRatio="xMidYMax meet" fill="none" aria-hidden="true">
                      <path d={ICONS.clock.d} class="fill-navy" />
                    </svg>
                    <span><strong class="font-medium" style={`color:${dayColor(day.n)}`}>{formatHours(day.elapsedS)}</strong></span>
                  </span>
                </p>
              )}
            </div>
            {!day.noTrace && (
              <div class="font-mono hidden shrink-0 self-center sm:flex">
                {[
                  [`${day.distanceKm}km`, "distance", ICONS.route.d, "fa", ICONS.route.viewBox],
                  [`${day.gainM}mD+`, "dénivelé", ICONS.mountain.d, "fa", ICONS.mountain.viewBox],
                  [formatHours(day.movingS), "effort", move.d, "fa", move.viewBox],
                  [formatHours(day.elapsedS), "au total", ICONS.clock.d, "fa", ICONS.clock.viewBox],
                ].map(([value, label, icon, extra, vb], i) => (
                  <div class={`px-3.5 text-center ${i > 0 ? "border-l border-navy/20" : ""}`}>
                    <svg
                      width="14"
                      height="14"
                      viewBox={vb ?? "0 0 16 16"} preserveAspectRatio="xMidYMax meet"
                      fill="none"
                      class="stroke-navy mx-auto mb-1"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      {extra === "dot" && <circle cx="2.5" cy="13" r="1.2" class="fill-navy" stroke="none" />}
                      {extra === "clock" && <circle cx="8" cy="8" r="6" />}
                      <path d={icon} {...(extra === "fa" ? { class: "fill-navy", stroke: "none" } : {})} />
                    </svg>
                    <div class="text-[12px] font-medium" style={`color:${dayColor(day.n)}`}>{value}</div>
                    <div class="mt-0.5 text-[8px] uppercase tracking-[0.14em] text-navy">{label}</div>
                  </div>
                ))}
              </div>
            )}
          </header>
          <DayGallery slug={tour.slug} day={day.n} eager={day.n === 1} />
        </article>
      ))
    }
  </section>

  <!-- Navigation entre éditions -->
  <nav
    class="mx-auto mt-14 flex max-w-6xl items-center justify-center gap-16 px-4 sm:px-6"
    aria-label="Autres Love Tours"
  >
    {
      older ? (
        <a
          href={`/tours/${older.slug}/`}
          title={`${older.year} · ${older.title}`}
          aria-label={`Édition précédente : ${older.title} ${older.year}`}
          class={`text-4xl text-navy/60 transition ${hoverAccent(older)}`}
        >
          ←
        </a>
      ) : (
        <span class="cursor-default select-none text-4xl text-navy/15" aria-hidden="true">←</span>
      )
    }
    {
      newer ? (
        <a
          href={`/tours/${newer.slug}/`}
          title={`${newer.year} · ${newer.title}`}
          aria-label={`Édition suivante : ${newer.title} ${newer.year}`}
          class={`text-4xl text-navy/60 transition ${hoverAccent(newer)}`}
        >
          →
        </a>
      ) : (
        <span class="cursor-default select-none text-4xl text-navy/15" aria-hidden="true">→</span>
      )
    }
  </nav>

  <!-- Retour en haut -->
  <button
    id="back-to-top"
    aria-label="Retour en haut"
    class={`font-mono fixed bottom-5 right-5 z-20 h-11 w-11 cursor-default items-center justify-center border border-navy/40 bg-paper text-lg text-navy shadow-sm transition hover:border-navy ${hoverAccent(tour)}`}
    style="display:none">↑</button
  >

  <script
    type="application/json"
    id="day-stats-data"
    is:inline
    set:html={JSON.stringify({
      days: tour.days
        .filter((d) => !d.noTrace)
        .map((d) => ({ n: d.n, distanceKm: d.distanceKm, gainM: d.gainM, movingS: d.movingS, elapsedS: d.elapsedS, color: dayColor(d.n) })),
      totals: tour.totals,
    })}
  />
  <script>
    import { formatHours } from "../../lib/tours.js";
    import { parseDayHash, dayHash } from "../../lib/dayhash.js";

    // Clic sur une puce de jour : stats du cartouche (teintées à la couleur du
    // jour), état actif du bouton, et hash #jN pour survivre au rechargement.
    const { days: dayStats, totals } = JSON.parse(
      document.getElementById("day-stats-data")!.textContent!,
    );
    const cells = document.querySelectorAll("#edition-stats > div");
    const setStats = (rows: [string | number, string][], color?: string) =>
      rows.forEach(([value, label], i) => {
        const dd = cells[i].querySelector("dd")!;
        dd.textContent = String(value);
        dd.style.color = color ?? "";
        cells[i].querySelector("dt")!.textContent = label;
      });
    const buttons = [...document.querySelectorAll<HTMLElement>("[data-zoom-day]")];
    const selectDay = (n: number, scroll = true) => {
      buttons.forEach((b) => b.classList.toggle("border-navy", +b.dataset.zoomDay! === n));
      buttons.forEach((b) => b.classList.toggle("bg-paper-deep", +b.dataset.zoomDay! === n));
      const d = dayStats.find((x: any) => x.n === n);
      setStats(
        d
          ? [[d.distanceKm, "km"], [d.gainM, "m dénivelé +"], [formatHours(d.movingS), "effort"], [formatHours(d.elapsedS), "au total"]]
          : [[totals.distanceKm, "km"], [totals.days, "jours"], [totals.gainM, "m dénivelé +"], [formatHours(totals.movingS), "effort"]],
        d?.color,
      );
      history.replaceState(null, "", n > 0 ? dayHash(n) : location.pathname + location.search);
      // Si le cartouche n'est pas visible (clic depuis la carte, plus bas),
      // remonter en douceur jusqu'à lui.
      const stats = document.getElementById("edition-stats")!;
      const r = stats.getBoundingClientRect();
      if (scroll && (r.top < 0 || r.bottom > innerHeight)) {
        stats.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    };
    buttons.forEach((btn) => btn.addEventListener("click", () => selectDay(+btn.dataset.zoomDay!)));
    const initial = parseDayHash(location.hash);
    if (initial != null && dayStats.some((d: any) => d.n === initial)) selectDay(initial, false);
    // ESC : retour à la vue complète (carte, stats, hash) — sauf si une boîte
    // de dialogue (lightbox) est ouverte : son ESC natif la ferme, sans plus.
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      if (document.querySelector("dialog[open]")) return;
      document.querySelector<HTMLElement>('[data-zoom-day="0"]')?.click();
    });
  </script>

  <script>
    const btn = document.getElementById("back-to-top")!;
    btn.addEventListener("click", () =>
      window.scrollTo({ top: 0, behavior: "smooth" }),
    );
    const toggle = () => {
      btn.style.display = window.scrollY < 600 ? "none" : "flex";
    };
    window.addEventListener("scroll", toggle, { passive: true });
    toggle();
  </script>

  <Lightbox />
</Base>
