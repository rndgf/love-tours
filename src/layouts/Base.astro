---
import "../styles/global.css";
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/700.css";
import { tours } from "../lib/tours.js";
import BackgroundMap from "../components/BackgroundMap.astro";
import LogoMark from "../components/LogoMark.astro";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Nos étés à deux, à vélo ou à pied, depuis 2021." } = Astro.props;
const firstYear = tours.length ? Math.min(...tours.map((t) => t.year)) : new Date().getFullYear();
const lastYear = tours.length ? Math.max(...tours.map((t) => t.year)) : new Date().getFullYear();

---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <!-- Favicon volontairement distinct du picto du header : pastille navy,
         cœur papier — un seul signe, lisible en 16 px. -->
    <link rel="icon" href={`data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 36 36"><circle cx="18" cy="18" r="17" fill="#1e2f4d"/><path d="M18 27.5 C10.2 21.4 8.2 16.6 12 13.2 C14.7 10.8 17.45 12.8 18 14.9 C18.55 12.8 21.3 10.8 24 13.2 C27.8 16.6 25.8 21.4 18 27.5 Z" fill="#faf6ee"/></svg>')}`} />
  </head>
  <!-- Colonne flex pleine hauteur : le footer reste ferré en bas même sur
       les pages courtes (à propos, 404), main absorbe l'espace restant. -->
  <body class="relative flex min-h-screen flex-col antialiased">
    <!-- Fond cartographique réel : côtes de la Manche, Seine et Loire, traces des
         Love Tours — centré sur la maison (Sotteville-lès-Rouen).
         absolute + sticky (PAS fixed : un fixed inset-0 déborde sous la barre
         de défilement → 20 px de balayage horizontal parasite). -->
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-clip" aria-hidden="true">
      <div class="sticky top-0 h-screen">
        <BackgroundMap />
      </div>
    </div>
    <!-- Desktop : header épinglé en haut au scroll (mobile : la nav des années
         de la homepage occupe déjà le haut d'écran). -->
    <header class="border-b border-navy bg-paper/80 sm:sticky sm:top-0 sm:z-30 sm:backdrop-blur-sm">
      <nav class="mx-auto flex max-w-6xl items-center justify-center px-4 py-4 sm:justify-between sm:px-6 sm:py-5">
        <!-- Mobile : décalé d'une demi-largeur de picto (48px + gap 10px) pour
             centrer optiquement le wordmark, pas le bloc picto+texte. -->
        <a href="/" class="logo-live flex -translate-x-[29px] items-center gap-2.5 sm:translate-x-0">
          <!-- Picto : roue de vélo + cœur, sentier pointillé (rando) -->
          <LogoMark class="h-12 w-12 shrink-0" />
          <span class="flex flex-col leading-none">
            <span class="font-display text-[1.35rem] font-semibold tracking-tight sm:text-2xl">
              Mélanie <span class="logo-amp text-framboise"
                ><span class="amp-char">&amp;</span><span class="amp-heart" aria-hidden="true">&#x2764;&#xFE0E;</span></span
              > Renaud
            </span>
            <span class="font-mono mt-1.5 text-center text-[10px] font-bold uppercase tracking-[0.22em] text-navy" style="text-indent: 0.22em;">
              Love&nbsp;Tours
            </span>
          </span>
        </a>
        <p class="font-mono hidden text-[10px] uppercase tracking-[0.18em] text-navy sm:block">
          Atlas de nos étés · <span class="text-framboise">{firstYear}–{lastYear}</span>
        </p>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <!-- Ombre vers le haut : détache le footer du fond de carte -->
    <footer class="relative mt-16 bg-paper/80 shadow-[0_-4px_12px_rgba(30,47,77,0.1)] sm:mt-24">
      <!-- Bordure haute en trois morceaux : deux segments + arc qui épouse le
           médaillon sans l'entourer. -->
      {
        ["left-0", "right-0"].map((side) => (
          <span
            aria-hidden="true"
            class={`wave-line absolute top-[-10px] h-5 w-[calc(50%-38px)] ${side}`}
          />
        ))
      }
      <svg
        aria-hidden="true"
        viewBox="0 0 76 38"
        fill="none"
        class="absolute left-1/2 top-[-36px] h-[38px] w-[76px] -translate-x-1/2"
      >
        <path
          d="M2 36.5 A36 36 0 0 1 74 36.5"
          stroke="#1e2f4d"
          stroke-opacity="0.5"
          stroke-width="1.6"
          stroke-dasharray="0.5 6.5"
          stroke-linecap="round"
        />
      </svg>
      <!-- LOVE / TOURS de part et d'autre du médaillon, sous les pointillés -->
      <span
        aria-hidden="true"
        class="font-mono absolute right-1/2 top-2 mr-14 text-[10px] font-bold uppercase tracking-[0.22em] text-navy"
        >Love</span
      >
      <span
        aria-hidden="true"
        class="font-mono absolute left-1/2 top-2 ml-14 text-[10px] font-bold uppercase tracking-[0.22em] text-navy"
        >Tours</span
      >
      <!-- Picto en médaillon sous l'arc : rappel du header, format sceau.
           Lien vers l'accueil (sur l'accueil : simple remontée douce). -->
      <a
        href="/"
        id="footer-top"
        aria-label="Retour à l'accueil"
        class="footer-seal logo-live absolute left-1/2 top-0 -translate-x-1/2 -translate-y-1/2 rounded-full bg-paper p-1.5 leading-none"
      >
        <LogoMark class="h-14 w-14" />
      </a>
      <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 pb-10 pt-14 text-center sm:px-6">
        <p class="font-display relative text-xl italic tracking-tight text-ink">
          <span aria-hidden="true" class="pointer-events-none absolute -left-2 -top-5 select-none text-5xl not-italic leading-none text-navy/15 sm:-left-9">«</span>
          Nos étés se suivent, à vélo, à pied, à vélo, à pied… toujours ensemble.
          <span aria-hidden="true" class="pointer-events-none absolute -bottom-7 -right-2 select-none text-5xl not-italic leading-none text-navy/15 sm:-right-9">»</span>
        </p>
        <p class="font-mono text-[9px] uppercase tracking-[0.18em] text-navy">
          {firstYear}–{lastYear} · <a href="/a-propos/" class="underline decoration-navy/30 underline-offset-2 transition hover:text-laiton">à propos</a> · Site par <a href="https://www.renaudgouffe.fr/" target="_blank" rel="noopener" class="underline decoration-navy/30 underline-offset-2 transition hover:text-laiton">rndgf</a>
        </p>
      </div>
    </footer>
    <script>
      import { initSmoothScroll, scrollToTop } from "../scripts/smooth-scroll";
      import { initStatCounters } from "../scripts/stat-counters";

      initSmoothScroll();
      initStatCounters();

      // Médaillon du footer : lien vers l'accueil. Déjà sur l'accueil :
      // remontée douce plutôt qu'un rechargement de page.
      document.getElementById("footer-top")?.addEventListener("click", (e) => {
        if (location.pathname !== "/") return;
        e.preventDefault();
        scrollToTop();
      });
    </script>
  </body>
</html>
