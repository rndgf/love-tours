---
import "../styles/global.css";
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/700.css";
import { tours } from "../lib/tours.js";
import BackgroundMap from "../components/BackgroundMap.astro";
import LogoMark from "../components/LogoMark.astro";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Nos étés à deux, à vélo ou à pied, depuis 2021." } = Astro.props;
const firstYear = tours.length ? Math.min(...tours.map((t) => t.year)) : new Date().getFullYear();
const lastYear = tours.length ? Math.max(...tours.map((t) => t.year)) : new Date().getFullYear();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <!-- Favicon volontairement distinct du picto du header : pastille navy,
         cœur papier — un seul signe, lisible en 16 px. -->
    <link rel="icon" href={`data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 36 36"><circle cx="18" cy="18" r="17" fill="#1e2f4d"/><path d="M18 27.5 C10.2 21.4 8.2 16.6 12 13.2 C14.7 10.8 17.45 12.8 18 14.9 C18.55 12.8 21.3 10.8 24 13.2 C27.8 16.6 25.8 21.4 18 27.5 Z" fill="#faf6ee"/></svg>')}`} />
  </head>
  <body class="min-h-screen antialiased">
    <!-- Fond cartographique réel : côtes de la Manche, Seine et Loire, traces des
         Love Tours — centré sur la maison (Sotteville-lès-Rouen). -->
    <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
      <BackgroundMap />
    </div>
    <!-- Desktop : header épinglé en haut au scroll (mobile : la nav des années
         de la homepage occupe déjà le haut d'écran). -->
    <header class="border-b border-navy bg-paper/80 sm:sticky sm:top-0 sm:z-30 sm:backdrop-blur-sm">
      <nav class="mx-auto flex max-w-6xl items-center justify-center px-4 py-4 sm:justify-between sm:px-6 sm:py-5">
        <a href="/" class="logo-live flex items-center gap-2.5">
          <!-- Picto : roue de vélo + cœur, sentier pointillé (rando) -->
          <LogoMark class="h-12 w-12 shrink-0" />
          <span class="flex flex-col leading-none">
            <span class="font-display text-[1.35rem] font-semibold tracking-tight sm:text-2xl">
              Mélanie <span class="logo-amp text-carmin"
                ><span class="amp-char">&amp;</span><span class="amp-heart" aria-hidden="true">&#x2764;&#xFE0E;</span></span
              > Renaud
            </span>
            <span class="font-mono mt-1.5 text-center text-[10px] font-bold uppercase tracking-[0.22em] text-navy" style="text-indent: 0.22em;">
              Love&nbsp;Tours
            </span>
          </span>
        </a>
        <p class="font-mono hidden text-[10px] uppercase tracking-[0.18em] text-navy sm:block">
          Atlas de nos étés · {firstYear}–{lastYear}
        </p>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="relative mt-16 bg-paper/80 sm:mt-24">
      <!-- Bordure haute en trois morceaux : deux segments + arc qui épouse le
           médaillon sans l'entourer. -->
      <span
        aria-hidden="true"
        class="absolute left-0 top-[-10px] h-5 w-[calc(50%-38px)]"
        style="background-image: url(data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%27600%27%20height%3D%2720%27%20viewBox%3D%270%200%20600%2020%27%3E%3Cpath%20d%3D%27M0%2C10%20C40%2C2%2070%2C16%20110%2C9%20C150%2C3%20185%2C18%20230%2C12%20C275%2C6%20300%2C3%20350%2C11%20C395%2C18%20430%2C4%20480%2C7%20C525%2C10%20565%2C15%20600%2C10%27%20fill%3D%27none%27%20stroke%3D%27%231e2f4d%27%20stroke-opacity%3D%270.5%27%20stroke-width%3D%271.6%27%20stroke-dasharray%3D%270.5%206.5%27%20stroke-linecap%3D%27round%27%2F%3E%3C%2Fsvg%3E); background-repeat: repeat-x;"
      />
      <span
        aria-hidden="true"
        class="absolute right-0 top-[-10px] h-5 w-[calc(50%-38px)]"
        style="background-image: url(data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%27600%27%20height%3D%2720%27%20viewBox%3D%270%200%20600%2020%27%3E%3Cpath%20d%3D%27M0%2C10%20C40%2C2%2070%2C16%20110%2C9%20C150%2C3%20185%2C18%20230%2C12%20C275%2C6%20300%2C3%20350%2C11%20C395%2C18%20430%2C4%20480%2C7%20C525%2C10%20565%2C15%20600%2C10%27%20fill%3D%27none%27%20stroke%3D%27%231e2f4d%27%20stroke-opacity%3D%270.5%27%20stroke-width%3D%271.6%27%20stroke-dasharray%3D%270.5%206.5%27%20stroke-linecap%3D%27round%27%2F%3E%3C%2Fsvg%3E); background-repeat: repeat-x;"
      />
      <svg
        aria-hidden="true"
        viewBox="0 0 76 38"
        fill="none"
        class="absolute left-1/2 top-[-36px] h-[38px] w-[76px] -translate-x-1/2"
      >
        <path
          d="M2 36.5 A36 36 0 0 1 74 36.5"
          stroke="#1e2f4d"
          stroke-opacity="0.5"
          stroke-width="1.6"
          stroke-dasharray="0.5 6.5"
          stroke-linecap="round"
        />
      </svg>
      <!-- Picto en médaillon sous l'arc : rappel du header, format sceau.
           Lien de retour en haut de page (défilement doux via Lenis). -->
      <a
        href="#"
        id="footer-top"
        aria-label="Retour en haut de page"
        class="footer-seal logo-live absolute left-1/2 top-0 -translate-x-1/2 -translate-y-1/2 rounded-full bg-paper p-1.5 leading-none"
      >
        <LogoMark class="h-14 w-14" />
      </a>
      <div class="mx-auto flex max-w-6xl flex-col items-center gap-3 px-4 pb-10 pt-14 text-center sm:px-6">
        <p class="text-sm text-ink-soft">Un été sur deux à vélo, l'autre à pied — toujours à deux. <span class="text-carmin">❤</span></p>
        <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-navy">
          {firstYear}–{lastYear} · Site par <a href="https://www.renaudgouffe.fr/" target="_blank" rel="noopener" class="underline decoration-navy/30 underline-offset-2 transition hover:text-carmin">rndgf</a>
        </p>
      </div>
    </footer>
    <script>
      import Lenis from "lenis";

      // Défilement global lissé (inertie). anchors: true reprend les liens
      // d'ancre (#y2021, #jN…). Désactivé si l'utilisateur préfère réduire
      // les animations — retour au défilement natif.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const lenis = new Lenis({ autoRaf: true, anchors: true });
        (window as any).lenis = lenis;
      }

      // Retour en haut sans laisser « # » dans l'URL (le lien seul reste
      // fonctionnel sans JavaScript, en défilement instantané).
      document.getElementById("footer-top")?.addEventListener("click", (e) => {
        e.preventDefault();
        const lenis = (window as any).lenis;
        if (lenis) lenis.scrollTo(0);
        else window.scrollTo({ top: 0, behavior: "smooth" });
      });

      // Compteurs des cartouches de stats (.stat-count) : au premier
      // affichage, chaque nombre défile de 0 jusqu'à sa valeur (décélération
      // en fin de course). Les caractères non numériques (« h » de l'effort)
      // restent fixes ; un segment écrit avec zéro initial (« 05 ») garde sa
      // largeur (padStart), les autres s'allongent naturellement.
      const counters = document.querySelectorAll<HTMLElement>(".stat-count");
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const countUp = (el: HTMLElement) => {
          const final = el.textContent ?? "";
          // Découpe en segments : suites de chiffres (animées) / reste (fixe).
          const parts = final.match(/\d+|\D+/g) ?? [];
          const DURATION = 1200;
          let start = 0;
          // Une seule animation par élément : la nouvelle annule la précédente
          // (sinon deux boucles rAF se disputeraient le texte).
          cancelAnimationFrame((el as any).__cuRaf ?? 0);
          const step = (t: number) => {
            if (!start) start = t;
            const p = Math.min((t - start) / DURATION, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = parts
              .map((seg) => {
                if (!/^\d/.test(seg)) return seg;
                const shown = String(Math.round(parseInt(seg, 10) * eased));
                return seg.startsWith("0") ? shown.padStart(seg.length, "0") : shown;
              })
              .join("");
            if (p < 1) (el as any).__cuRaf = requestAnimationFrame(step);
            else el.textContent = final;
          };
          (el as any).__cuRaf = requestAnimationFrame(step);
        };
        // Exposé aux pages : la page détail relance l'animation quand le
        // cartouche change de valeurs (clic sur un jour) — y compris quand
        // les spans .stat-count ont déjà été remplacés (deep-link #jN).
        (window as any).statCountUp = countUp;
        if (counters.length) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  io.unobserve(e.target);
                  countUp(e.target as HTMLElement);
                }
              }
            },
            { threshold: 0.4 }
          );
          counters.forEach((el) => io.observe(el));
        }
      }
    </script>
  </body>
</html>
